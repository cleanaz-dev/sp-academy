model Conversation {
  id                 String               @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  scenario           String?
  metadata           Json?
  nativeLanguage     Languages?
  tutorLanguage      Languages?
  level              Level?
  introduction       Json
  vocabulary         Json[]
  characters         Json[]
  dialogue           Json[]
  userId             String               @db.ObjectId
  user               User                 @relation(fields: [userId], references: [id])
  messages           Json?
  imageUrl           String?
  aiAvatarUrl        String?
  aiAvatarMaleUrl    String?
  aiAvatarFemaleUrl  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  ConversationRecord ConversationRecord[]
  ConversationReview ConversationReview[]
}

model ConversationRecord {
  id                  String       @id @default(auto()) @map("_id") @db.ObjectId
  userId              String       @db.ObjectId
  user                User         @relation(fields: [userId], references: [id])
  conversationId      String       @db.ObjectId
  conversation        Conversation @relation(fields: [conversationId], references: [id])
  messages            Json?
  analysis            Json?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  pronunciationScores Json?
}

model ConversationReview {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  userId         String       @db.ObjectId
  user           User         @relation(fields: [userId], references: [id])
  conversationId String       @unique @db.ObjectId
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  mistakes       Json[] // <-- Change from Json? to Json[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum FreestyleLevel {
  ZERO
  EASY
  MEDIUM
  FLUENT
}

enum FreestyleMode {
  INTRODUCTION
  SPECIFIC
  RANDOM
  ARGUMENTATIVE
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  REVIEW_PENDING
  REVIEWED
}

enum VoiceGender {
  MALE
  FEMALE
}

model FreestyleSession {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  userId         String         @db.ObjectId
  user           User           @relation(fields: [userId], references: [id])
  mode           FreestyleMode
  level          FreestyleLevel @default(EASY) // <-- ADD THIS
  topic          String?
  nativeLanguage String
  targetLanguage String
  voiceGender    VoiceGender    @default(FEMALE) // <-- ADD THIS (from your UI)
  aiAvatarUrl    String?
  isFoundation   Boolean?       @default(false)

  duration       Int           @default(0)
  status         SessionStatus @default(IN_PROGRESS)
  messages       Json[]
  fullTranscript String?
  s3AudioKey     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review                 FreestyleReview?
  FoundationFreestyleLog FoundationFreestyleLog[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model FreestyleReview {
  id                 String           @id @default(auto()) @map("_id") @db.ObjectId
  freestyleSessionId String           @unique @db.ObjectId
  session            FreestyleSession @relation(fields: [freestyleSessionId], references: [id], onDelete: Cascade)

  mistakes        Json[]
  overallFeedback Json?
  grammarAnalysis Json?
  vocabUpgrades   Json?
  metrics         Json?
  lambdaStatus    LambdaStatus? @default(PENDING)

  hasUserReviewed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LambdaStatus {
  PENDING
  SUCCESS
  FAILED
}

model LanguageProfile {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  userId       String @db.ObjectId
  languageCode String // e.g., "fr-FR", "es-ES"
  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wordStats WordStat[]

  // A user can only have ONE profile per language
  @@unique([userId, languageCode])
}

model WordStat {
  id                String @id @default(auto()) @map("_id") @db.ObjectId
  languageProfileId String @db.ObjectId
  word              String // e.g., "bonjour", "la plante"

  // 1. Passive Metrics
  seenCount   Int      @default(0)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  // Passive Listening (NEW)
  heardCount  Int       @default(0)
  lastHeardAt DateTime?

  // 2. Active Metrics (Tapping / Multiple Choice / Sorting)
  tappedCorrect Int       @default(0)
  tappedWrong   Int       @default(0)
  lastTappedAt  DateTime?

  // 3. Production Metrics (Azure Pronunciation)
  spokenAttempts Int       @default(0)
  avgSpokenScore Float? // Out of 100
  lastSpokenAt   DateTime?

  // 4. Algorithm / Spaced Repetition (SRS)
  masteryScore   Float     @default(0) // Calculated based on above metrics
  status         String    @default("NEW") // NEW, LEARNING, FAMILIAR, MASTERED
  nextReviewDate DateTime?

  languageProfile LanguageProfile @relation(fields: [languageProfileId], references: [id], onDelete: Cascade)

  // Ensures we only have one row per word, per user's language profile
  @@unique([languageProfileId, word])
  // Index for fast querying when building review sessions
  @@index([nextReviewDate])
}
