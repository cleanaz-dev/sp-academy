enum FoundationLessonStatus {
  BUILDING
  IN_PROGRESS
  COMPLETED
}

model FoundationCourse {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  nativeLanguage String // E.g., "es-ES" or "Spanish"
  targetLanguage String
  cacheKey       String // e.g., "en-US:es-ES:beginner:travel"

  // Planner-generated day-by-day outline
  outline Json?

  lessons  FoundationLesson[]
  progress FoundationProgress? // One-to-one link for easy progress fetching

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Since courses are now personal, cacheKey shouldn't be globally @unique. 
  // This prevents the user from accidentally creating the exact same course twice:
  @@unique([userId, cacheKey])
}

model FoundationLesson {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  title  String?

  foundationCourseId String
  course             FoundationCourse @relation(fields: [foundationCourseId], references: [id])

  orderIndex Int

  // Replaced string with an Enum
  status FoundationLessonStatus @default(BUILDING)

  // Primitive-shaped payloads
  visualContent     Json?
  grammarContent    Json?
  pronunciationData Json?
  listeningContent  Json?
  quizContent       Json?
  lessonHandoff     Json?
  freestyle         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([foundationCourseId, orderIndex]) // Idempotency guard
  @@index([userId, foundationCourseId])
}

model FoundationProgress {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  foundationCourseId String           @unique
  course             FoundationCourse @relation(fields: [foundationCourseId], references: [id])

  currentSpoon        Int      @default(1)
  completedLessonIds String[] // Store the IDs of completed lessons here

  // Gamification & Stats
  totalXp        Int   @default(0)
  overallFluency Float @default(0)
  skillMastery   Json? // e.g., { "rr": 85, "past_tense": 60 }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensures a user only has one progress tracker per course instance
  @@unique([userId, foundationCourseId])
}

model FoundationFreestyleLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Condensed everything into a single results JSON
  results Json?

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  freestyleSession   FreestyleSession? @relation(fields: [freestyleSessionId], references: [id])
  freestyleSessionId String?
}
