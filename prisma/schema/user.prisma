enum Gender {
  M
  F
  N
}

// 1. STATIC CATALOG: Vox and Vivi
model Sprite {
  id        String   @id @default(cuid())
  slug      String   @unique // "vox" | "vivi"
  name      String   // "Vox" | "Vivi"
  avatarUrl String   // "/sprite-m.png" | "/sprite-f.png"
  moodUrls  String[]
  persona   String?

  profiles SpriteProfile[]
}

// 2. USER'S SELECTION: Links User -> Sprite + their chosen Voice IDs
model SpriteProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  spriteId       String

  nativeLanguage String   // e.g. "en-US"
  targetLanguage String   // e.g. "fr-FR"
  nativeVoiceId  String   // e.g. "en-US-boy-01"
  targetVoiceId  String   // e.g. "fr-FR-boy-01"

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sprite         Sprite   @relation(fields: [spriteId], references: [id])
}

// 3. GLOBAL DETERMINISTIC CACHE (Option 1)
model SpriteNode {
  id             String   @id @default(cuid())
  nodeId         String   @unique // "vox:en-US-boy-01:fr-FR-boy-01:1"
  spriteSlug     String   // "vox" | "vivi"
  nativeLanguage String   // "en-US"
  targetLanguage String   // "fr-FR"
  nativeVoiceId  String   // "en-US-boy-01"
  targetVoiceId  String   // "fr-FR-boy-01"
  orderIndex     Int      // 1=Spoon1, 2=Spoon2, 3=Spoon3, 4=Boss1

  header         String   // "Spoon 1 Ready 🥄"
  nativeBody     String   @db.Text
  targetBody     String   @db.Text
  nativeAudioUrl String?  // S3 key for native MP3
  targetAudioUrl String?  // S3 key for target MP3
  action         String?  // "Start Spoon 1"

  createdAt      DateTime @default(now())

  @@index([spriteSlug, orderIndex])
}

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  // Kept clean via 1-to-1 SpriteProfile relation:
  spriteProfile SpriteProfile?

  emailVerified   Boolean  @default(false)
  image           String?
  username        String?  @unique
  displayUsername String?
  firstName       String?
  lastName        String?
  gender          Gender?  @default(N)

  avatarUrl  String?
  phone      String?
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  sessions Session[]
  accounts Account[]

  role      UserRole @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nativeLanguage Languages? @default(ENGLISH)
  targetLanguage Languages? @default(FRENCH)

  Journal               Journal[]
  StoryQuestions        StoryQuestions[]
  PronunciationSession  PronunciationSession[]
  PronunciationProgress PronunciationProgress[]
  PracticeSessions      PracticeSession[]
  BookReport            BookReport[]
  Book                  Book[]
  Conversation          Conversation[]
  LearningProgress      LearningProgress[]
  ConversationRecord    ConversationRecord[]
  AccountSettings       AccountSettings?
  BillingInformation    BillingInformation?
  UserProgress          UserProgress[]
  Like                  Like[]
  Course                Course[]
  Enrollment            Enrollment[]
  Progress              Progress[]
  Teacher               Teacher?
  QuizResult            QuizResult[]
  Resource              Resource[]
  AIGeneratedContent    AIGeneratedContent[]
  notifications         Notification[]
  GameScore             GameScore[]
  UserSchedule          UserSchedule[]
  ConversationReview    ConversationReview[]
  ReadingLog            ReadingLog[]
  dailyJournals         DailyJournal[]
  FreestyleSession      FreestyleSession[]
  FoundationProgress    FoundationProgress?

  FoundationLesson       FoundationLesson[]
  FoundationFreestyleLog FoundationFreestyleLog[]
  languageProfiles       LanguageProfile[]
  foundationCourses      FoundationCourse[]
  foundationBossStages   FoundationBossStage[]
}

model BillingInformation {
  id                   String          @id @default(cuid())
  user                 User            @relation(fields: [userId], references: [id])
  userId               String          @unique
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPlan          Billing         @default(FREE)
  billingInterval      BillingInterval @default(MONTHLY)
  nextBillingDate      DateTime?
  isActive             Boolean         @default(true)
  cancelAtPeriodEnd    Boolean         @default(false)
  lastPaymentDate      DateTime?
  paymentStatus        PaymentStatus   @default(UNPAID)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model AccountSettings {
  id                        String          @id @default(cuid())
  user                      User            @relation(fields: [userId], references: [id])
  userId                    String          @unique
  language                  Languages       @default(ENGLISH)
  displayName               String?
  avatarUrl                 String?
  aiVoicePreference         VoicePreference @default(MALE)
  level                     Level?          @default(BEGINNER)
  dailyEmails               Boolean?        @default(true)
  weeklyEmails              Boolean?        @default(true)
  promotionEmails           Boolean?        @default(true)
  shareReadingLogs          Boolean         @default(false)
  shareConversationActivity Boolean         @default(false)
  shareAchievements         Boolean         @default(false)
  shareLessonsAndCourses    Boolean         @default(false)
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model Teacher {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id])
  userId   String   @unique
  subjects String[]
  lessons  Lesson[]
}

model Journal {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  callId       String
  record       Boolean?
  recordingUrl String?
  length       String?
  completed    Boolean
  summary      String?
  to           String?
  from         String?
  transcripts  String?
  language     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  type      String // e.g., "DOCUMENT", "VIDEO", "LINK"
  content   String
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AIGeneratedContent {
  id        String   @id @default(cuid())
  title     String
  type      String // e.g., "EXERCISE", "EXPLANATION", "QUIZ"
  content   Json
  context   String? // Store the conversation context that generated this
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id           String         @id @default(cuid())
  name         String
  description  String?
  category     Category       @relation(fields: [categoryId], references: [id])
  criteria     Json
  imageUrl     String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  categoryId   String
  UserProgress UserProgress[]
}

model UserProgress {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  achievementId String
  progress      Json?
  unlockedAt    DateTime?
  isUnlocked    Boolean?    @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Category {
  id           String        @id @default(cuid())
  name         String
  achievements Achievement[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  activityId String
  type       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, activityId])
}

model Notification {
  id            String   @id @default(cuid())
  type          String
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  toUserId      String
  fromUserId    String
  activityId    String
  activityType  String
  activityTitle String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, activityId, fromUserId])
  @@index([userId, isRead]) // For fetching unread notifications
  @@index([activityId, type]) // For activity-specific notifications
}

model UserSchedule {
  id         String        @id @default(cuid())
  user       User          @relation(fields: [userId], references: [id])
  userId     String
  schedule   EmailSchedule @relation(fields: [scheduleId], references: [id])
  scheduleId String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([userId, scheduleId])
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impersonatedBy String?
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
